{
  "name": "sword-duel-2player",
  "version": "2.0.0",
  "description": "Universal local 2-player sword duel: browser, gamepad, phone motion and optional Windows Raw Input",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "electron": "electron .",
    "install-native": "cd native && node-gyp rebuild",
    "build-win": "electron-builder --win"
  },
  "dependencies": {
    "express": "^4.19.2",
    "socket.io": "^4.8.1",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "node-gyp": "^10.3.1",
    "node-addon-api": "^7.1.0"
  },
  "build": {
    "appId": "com.swordduel.local",
    "productName": "Sword Duel",
    "files": ["**/*", "!native/build/**/*"],
    "win": { "target": "nsis" }
  }
}
